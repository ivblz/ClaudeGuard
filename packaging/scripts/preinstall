#!/bin/bash
set -euo pipefail
if [ "${3:-/}" != / ]; then
    echo 'ClaudeGuard must be installed on the running startup disk.' >&2
    exit 1
fi
if ! /usr/bin/xcode-select -p >/dev/null 2>&1 || ! /usr/bin/python3 -I -c 'import sys; assert sys.version_info >= (3, 9)' >/dev/null 2>&1; then
    echo 'Install Xcode Command Line Tools first: xcode-select --install. Then reopen this installer.' >&2
    exit 1
fi
exec /usr/bin/python3 -I "$(dirname "$0")/configure.py" preinstall
